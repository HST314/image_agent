{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-agent.local/schemas/ProjectObservability.v1.schema.json",
  "title": "Project observability v1",
  "$defs": {
    "event": {
      "type": "object",
      "required": ["event_id", "sequence", "event_type", "phase", "job_id", "slot", "round", "status", "timestamp", "trace_id", "retry_count", "error_code", "message"],
      "properties": {
        "event_id": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 1},
        "event_type": {"type": "string", "maxLength": 128},
        "phase": {"type": "string", "maxLength": 128},
        "job_id": {"type": ["string", "null"], "maxLength": 128},
        "slot": {"type": ["integer", "null"], "minimum": 0},
        "round": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["queued", "running", "succeeded", "failed", "cancel_requested", "cancelled", "waiting", "retrying", "recovered", "partial"]},
        "timestamp": {"type": "string", "format": "date-time"},
        "trace_id": {"type": ["string", "null"], "pattern": "^trace_[a-f0-9]{32}$"},
        "retry_count": {"type": "integer", "minimum": 0},
        "error_code": {"type": ["string", "null"], "maxLength": 128},
        "message": {"type": ["string", "null"], "maxLength": 256}
      },
      "additionalProperties": false
    },
    "event_page": {
      "type": "object",
      "required": ["schema_version", "items", "next_cursor", "through_sequence"],
      "properties": {
        "schema_version": {"const": 1},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/event"}},
        "next_cursor": {"type": ["string", "null"]},
        "through_sequence": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["schema_version", "phase", "status", "job", "work", "candidates", "quality", "waiting_for_human", "through_sequence"],
      "properties": {
        "schema_version": {"const": 1},
        "phase": {"type": "string"},
        "status": {"type": "string"},
        "job": {
          "type": ["object", "null"],
          "properties": {
            "job_id": {"type": "string"}, "status": {"type": "string"},
            "attempt": {"type": "integer", "minimum": 0}, "retry_count": {"type": "integer", "minimum": 0}
          },
          "required": ["job_id", "status", "attempt", "retry_count"], "additionalProperties": false
        },
        "work": {
          "type": "object", "required": ["completed", "total", "unit"],
          "properties": {"completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}, "unit": {"type": "string"}},
          "additionalProperties": false
        },
        "candidates": {
          "type": "object", "required": ["completed_slots", "failed_slots", "total"],
          "properties": {"completed_slots": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
                         "failed_slots": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
                         "total": {"type": "integer", "minimum": 1}}, "additionalProperties": false
        },
        "quality": {
          "type": "object", "required": ["current_round", "max_rounds", "at_limit"],
          "properties": {"current_round": {"type": "integer", "minimum": 0}, "max_rounds": {"type": "integer", "minimum": 1}, "at_limit": {"type": "boolean"}},
          "additionalProperties": false
        },
        "waiting_for_human": {"type": "boolean"}, "through_sequence": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
