{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProjectBranch.v1.schema.json",
  "title": "ProjectBranch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch_id", "name", "parent_branch_id", "fork_checkpoint", "created_by", "created_at", "head", "status", "version", "current"],
  "properties": {
    "branch_id": {"type": "string", "pattern": "^branch_[a-f0-9]{32}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "parent_branch_id": {"type": ["string", "null"]},
    "fork_checkpoint": {"type": ["string", "null"]},
    "created_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "head": {"type": ["object", "null"]},
    "status": {"enum": ["active", "archived"]},
    "version": {"type": "integer", "minimum": 1},
    "current": {"type": "boolean"}
  }
}
