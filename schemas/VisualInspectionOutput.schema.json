{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualInspectionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "decision", "deviations", "rework_prompt_delta", "confidence"],
  "allOf": [
    {"if": {"properties": {"passed": {"const": true}}}, "then": {"properties": {"decision": {"const": "pass"}}}},
    {"if": {"properties": {"passed": {"const": false}}}, "then": {"properties": {"decision": {"enum": ["continue", "blocked"]}}}}
  ],
  "properties": {
    "passed": {"type": "boolean"},
    "decision": {"enum": ["continue", "pass", "blocked"]},
    "deviations": {"type": "array", "items": {"type": "string"}},
    "rework_prompt_delta": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
